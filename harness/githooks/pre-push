#!/usr/bin/env bash
#
# push 前の検査（git ネイティブのフック）。Claude Code の配線に依存しない最終網。
#
# 違いは発火条件だけで、こちらは CLI・IDE・素の git のどれから push しても必ず走る
# （AGENTS.md「強制力の序列」）。.claude/hooks/pre-push-check.sh もこのファイルを呼ぶ。
#
# 配線: git config core.hooksPath harness/githooks

cd "$(git rev-parse --show-toplevel)" || exit 1

# 検査は 1 つずつ独立に走らせ、落ちても止めずに最後まで走らせて、結果は最後の 1 行が言う
# (harness/githooks/README.md「結果の読み方」)。
. harness/githooks/lib/check-tally.sh || exit 1

# ツールが無い環境では、そのツールを使う検査を飛ばして通す。検査できないことを理由に
# push を止めても検査の質は上がらない。無条件のゲートは CI（層 1）にある。
# 飛ばした検査は最後の行で数える。
command -v cargo >/dev/null 2>&1 || skip_following_checks "cargo が無い"
run_check "fmt" bash harness/githooks/lib/rust-checks.sh fmt
run_check "clippy" bash harness/githooks/lib/rust-checks.sh clippy
run_check "doc" bash harness/githooks/lib/rust-checks.sh doc
run_check "test" bash harness/githooks/lib/rust-checks.sh test
run_check "cargo の検査の判定表" bash harness/githooks/lib/rust-checks-cases.sh
run_check "clippy の設定の判定表" bash harness/githooks/lib/clippy-config-cases.sh
resume_checks

# 行数の予算(AGENTS.md「常時ロードは増やさない」)。実測と予算がずれていれば落ちる。
run_check "行数のラチェット" bash harness/records/count.sh --ratchet

# 上の数え方そのものの判定表。
run_check "集計の判定表" bash harness/records/count-cases.sh

# 各 crate のソースのディレクトリ。
crate_sources=(crates/*/src)

# 単体テストのファイルの行数(rules/testing.md「段をまたぐテストと単体のテストを分ける」)と、その判定表。
for crate_source in "${crate_sources[@]}"; do
  run_check "テストのファイルの行数(${crate_source})" bash harness/githooks/lib/test-file-length.sh "$crate_source"
done
run_check "テストのファイルの行数の判定表" bash harness/githooks/lib/test-file-length-cases.sh

# 単体テストの置き場所(rules/testing.md「段をまたぐテストと単体のテストを分ける」)と、その判定表。
for crate_source in "${crate_sources[@]}"; do
  run_check "テストの置き場所(${crate_source})" bash harness/githooks/lib/test-placement.sh "$crate_source"
done
run_check "テストの置き場所の判定表" bash harness/githooks/lib/test-placement-cases.sh

# コメントの形(rules/coding.md「コメントは doc だけにする」)と、その判定表。
run_check "コメントの形" bash harness/githooks/lib/comment-style.sh crates
run_check "コメントの形の判定表" bash harness/githooks/lib/comment-style-cases.sh

# 行数・置き場所・コメントの検査に渡す根の判定表。
run_check "検査に渡す根の判定表" bash harness/githooks/lib/check-roots-cases.sh

# 層 3 のフックの判定表とテスト。フックそのものは CI では発火しないが、判定が壊れたことには
# ここと CI でしか気づけない。どれも bash だけで走るので飛ばさない。
run_check "作業ツリーを書き換えるサブエージェントの実行中フラグの判定表" bash .claude/hooks/lib/verification-agent-cases.sh
run_check "親セッションの編集の判定表" bash .claude/hooks/lib/parent-session-edit-cases.sh
run_check "判定の読み取りと報告と種別の照合の判定表" bash .claude/hooks/lib/cases-report-cases.sh
run_check "pre-push の結果行の判定表" bash harness/githooks/lib/check-tally-cases.sh
run_check "カナリアのテスト" bash .claude/hooks/hook-canary-test.sh
run_check "セッション URL の通知のテスト" bash .claude/hooks/session-url-notice-test.sh

# CI の Red のコミットの検査(.github/workflows/red-commits.yml)の判定表。git と bash だけで走るので飛ばさない。
run_check "Red のコミットの検査の判定表" bash .github/scripts/red-commits-cases.sh

# jq を使うフックと CI のスクリプトのテスト。jq が無い環境では判定が変わっていなくても落ちるので飛ばす。
command -v jq >/dev/null 2>&1 || skip_following_checks "jq が無い"
run_check "push 前の検査フックのテスト" bash .claude/hooks/pre-push-check-test.sh
run_check "マージ後の振り返りの促しのテスト" bash .claude/hooks/post-merge-review-test.sh
run_check "PR が閉じる Issue の検査の判定表" bash .github/scripts/check-pr-closing-issue-cases.sh
run_check "同じ Issue を閉じる他の PR の検査の判定表" bash .github/scripts/check-duplicate-issue-pr-cases.sh
run_check "sticky コメントの投稿・差し替えの判定表" bash .github/scripts/upsert-sticky-comment-cases.sh
resume_checks

# 道具の cooldown と lock の公開からの期間の判定表は偽の index を curl で読み、版の一覧を jq で読むので、curl と jq の両方が要る。
{ command -v curl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; } || skip_following_checks "curl か jq が無い"
run_check "道具の cooldown の判定表" bash harness/deps/tool-cooldown-cases.sh
run_check "lock の公開からの期間の判定表" bash .github/scripts/lock-publish-age-cases.sh
resume_checks

# 編集後の fmt / clippy フックのテストは使い捨てのクレートを作るので、cargo と jq の両方が要る。
{ command -v cargo >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; } || skip_following_checks "cargo か jq が無い"
run_check "編集後の fmt / clippy フックのテスト" bash .claude/hooks/post-edit-rust-test.sh
run_check "crate の依存の許可表の判定表" bash harness/githooks/lib/crate-deps-cases.sh
resume_checks

# この文の終了コードがフックの終了コードになる(後ろに文を足すと、失敗しても push が通る)。
# 判定表はこの配線を lib 側からは見られないので、最後の文であることを判定表が別に確かめる。
finish_checks
